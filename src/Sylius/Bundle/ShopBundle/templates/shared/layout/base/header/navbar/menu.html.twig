{% macro item(taxon) %}
    {% import _self as macros %}

    {% if taxon.enabledChildren|length > 0 %}
        <div class="nav-item dropdown position-static" {{ sylius_test_html_attribute('menu-item', taxon.name) }}>
            <a class="nav-link dropdown-toggle" href="{{ path('sylius_shop_product_index', {'slug': taxon.slug, '_locale': taxon.translation.locale}) }}" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                {{ taxon.name }}
            </a>
            {{ macros.megamenu(taxon.enabledChildren) }}
        </div>
    {% else %}
        <a class="nav-link" href="{{ path('sylius_shop_product_index', {'slug': taxon.slug, '_locale': taxon.translation.locale}) }}" {{ sylius_test_html_attribute('menu-item', taxon.name) }}>
            {{ taxon.name }}
        </a>
    {% endif %}
{% endmacro %}

{% macro megamenu(taxons) %}
    <div class="row">
        <div class="dropdown-menu" data-bs-popper="static">
            <div class="grid row-gap-4 column-gap-5 p-4 megamenu">
                {% for taxon in taxons %}
                    {% set rows_count = (taxon.enabledChildren|length|default(0) / 2)|round(0, 'ceil') %}
                    <div class="w-auto">
                        <div class="h6 border-bottom mb-3 pb-2">{{ taxon.name }}</div>
                        <ul class="grid row-gap-0 column-gap-4 list-unstyled list-nav megamenu--column" style="--megamenu-rows: {{ rows_count }};">
                            {% for child in taxon.enabledChildren %}
                                <li class="text-truncate"><a href="{{ path('sylius_shop_product_index', {'slug': child.slug, '_locale': child.translation.locale}) }}" class="d-inline">{{ child.name }}</a></li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endmacro %}

{% import _self as macros %}

<div class="w-100 border-bottom">
    {% if taxons|length > 0 %}
        <nav class="navbar navbar-expand-lg p-0">
            <div class="container position-relative">
                <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
                    <div class="navbar-nav my-2" {{ sylius_test_html_attribute('menu') }}>
                        {% for taxon in taxons %}
                            {{ macros.item(taxon) }}
                        {% endfor %}
                    </div>
                </div>
            </div>
        </nav>
    {% endif %}
</div>
